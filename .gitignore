# SPDX-License-Identifier: AGPL-3.0-only
# ==========================================
# PlainGym .gitignore
# ==========================================

# Dependencies
node_modules/
.pnp
.pnp.js

# Production Build Outputs
dist/
build/
out/
.turbo/

# Environment Variables & Secrets
# NEVER commit real credentials to a public repository
.env
.env.*
!.env.example

# Local Development & Logs
*.log
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*
lerna-debug.log*

# Database & Local Stores
*.local
*.sqlite
*.sqlite-journal
*.sqlite-wal
*.sqlite-shm
*.db
*.db-journal
*.db-wal
*.db-shm
data/
uploads/

# OS & Editor Files
.DS_Store
Thumbs.db
*.swp
*.swo
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
.idea/

# Local task worktrees (git worktree add .worktrees/<name>)
.worktrees/

# Coverage & Testing
coverage/
.nyc_output/
*.tsbuildinfo
routeTree.gen.ts
