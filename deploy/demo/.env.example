# Optional additions to the installer's root-only .env; keep real values private.
# One shared Stripe test account for every sandbox. Accepts sk_test_ or rk_test_.
# Leave both blank to create sandboxes without billing.
DEMO_STRIPE_TEST_KEY=
# Signing secret for the single https://<DEMO_DOMAIN>/webhooks/stripe endpoint.
DEMO_STRIPE_WEBHOOK_SECRET=
