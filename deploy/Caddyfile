{
	email {$ACME_EMAIL}
	admin off
}
{$GYM_HOSTNAME} {
	encode zstd gzip
	# Access log: off unless CADDY_ACCESS_LOG=stderr (see "Access log" in deploy/README.md). The filter drops every query
	# string, the token in a signed-link path and the setup token header (Caddy itself masks Cookie and Authorization).
	log {
		output {$CADDY_ACCESS_LOG:discard}
		format filter {
			wrap json
			fields {
				request>uri regexp "^(/l/)[^/?]*|\?.*$" "$1"
				request>headers>X-Setup-Token delete
			}
		}
	}
	# A random value per install: the installer fetches it through the hostname, so through any proxy in front, and
	# prints the private setup link only when it comes back, proving the name reaches this server. Not a secret.
	respond /.well-known/plaingym-origin "{$PLAINGYM_ORIGIN_NONCE}" 200
	reverse_proxy app:3000
}
