# SPDX-License-Identifier: AGPL-3.0-only
# Use independent URL-safe passwords (for example, openssl rand -hex 32).
COMPOSE_PROJECT_NAME=plaingym
APP_IMAGE=ghcr.io/plaingym/app:v0.0.0
GYM_HOSTNAME=gym.example.org
ACME_EMAIL=owner@example.org
POSTGRES_DB=plaingym
POSTGRES_PASSWORD=replace-bootstrap-password
APP_PASSWORD=replace-runtime-password
MAINTENANCE_PASSWORD=replace-maintenance-password
APP_ENCRYPTION_KEY=replace-with-64-hex-characters
AUTH_SECRET=replace-with-random-secret
# Modified installs should link to their corresponding source revision.
SOURCE_URL=https://github.com/plaingym/plaingym
APP_MEMORY_LIMIT=512m
POSTGRES_MEMORY_LIMIT=384m
CADDY_MEMORY_LIMIT=128m
NODE_OPTIONS=--max-old-space-size=256
# Generate an age key pair on your own computer. Only its public key goes here.
BACKUP_RECIPIENT=
# Optional install-wide email through a sending service (for example Postmark, Brevo, or Amazon SES).
# Most gyms set this up in the setup wizard instead; a gym's own settings take precedence.
# Never send directly from this server: mail from a VPS usually lands in spam or is blocked.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURITY=starttls
# SMTP_FROM=gym@example.org
# SMTP_USER=
# SMTP_PASS=
