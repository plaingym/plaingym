    "@hono/node-server": "2.1.5",
    "@hono/zod-openapi": "1.6.3",
    "@plaingym/db": "workspace:*",
    "@plaingym/shared": "workspace:*",
    "@react-email/render": "2.1.1",
    "age-encryption": "0.3.1",
    "better-auth": "1.7.12",
    "bidi-js": "1.1.0",
