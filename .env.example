# Copy to .env. Replace password placeholders; use distinct URL-safe values.
# Compose project names must be unique when running multiple worktrees.
COMPOSE_PROJECT_NAME=plaingym-dev
POSTGRES_DB=plaingym
POSTGRES_PORT=5432
POSTGRES_PASSWORD=replace-with-bootstrap-password
APP_PASSWORD=replace-with-app-password
MAINTENANCE_PASSWORD=replace-with-maintenance-password
# Match APP_PASSWORD, POSTGRES_PORT and POSTGRES_DB above; URL-encode the password.
DATABASE_URL=postgres://app:replace-with-app-password@127.0.0.1:5432/plaingym
MAILPIT_SMTP_PORT=1025
MAILPIT_HTTP_PORT=8025
# Development server; Vite proxies /healthz and /api here.
HOST=127.0.0.1
PORT=3000
# Required: public URL of this checkout's source (use your repository and commit).
SOURCE_URL=https://example.invalid/your-fork/tree/your-commit
# Authentication: generate an independent secret of at least 32 characters.
AUTH_SECRET=replace-with-an-independent-auth-secret
AUTH_PASSWORD_LOGIN=auto
# Gym creation requires a 32-byte encryption key encoded as 64 hex characters.
APP_ENCRYPTION_KEY=replace-with-64-random-hex-characters
# Login email is optional in single mode. Set AUTH_PASSWORD_LOGIN=off for multi.
# SMTP_HOST=127.0.0.1
# SMTP_PORT=1025
# SMTP_FROM=login@example.test
# SMTP_SECURITY=plain
# SMTP_USER=
# SMTP_PASS=
